durable/compose/
webgateway/durable/
webgateway/CSP.ini
webgateway/CSP.conf
*.csv
*.csv.gz
# but DO track the tiny committed CI fixture (real data stays ignored above)
!tests/fixtures/*.csv.gz

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS / editor
.DS_Store
Thumbs.db
